    "#reference count\n",
    "import sys\n",
    "a = []\n",
    "print(sys.getrefcount(a))\n",
    "b = a\n",
    "print(sys.getrefcount(a))\n",
    "del b\n",
    "print(sys.getrefcount(a))"
   ]
